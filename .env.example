# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Prefix for text commands. Leave EMPTY for slash-only operation: a non-empty
# value is what makes the bot request Discord's privileged message_content
# intent, which must then be enabled in the Developer Portal. Slash commands
# (/clan, /war, ...) always work either way.
BOT_PREFIX=

# Dev guild id -> slash commands sync instantly. Leave empty for global sync.
DISCORD_GUILD_ID=

# Paths to the snapshots and Town Hall art, copied into this repo.
# Relative paths resolve against this bot's own directory, not the shell's cwd.
DATA_DIR=./data
ASSET_DIR=./assets

# Where per-guild config and runtime state are stored.
CONFIG_DIR=./config/guilds

# Timezone used for quiet hours.
BOT_TIMEZONE=Asia/Jakarta

# ---------------------------------------------------------------------------
# Clash of Clans API (optional). Leave COC_API_TOKEN empty to read the
# committed snapshots instead — a clone with no secrets still runs.
#
# Create a token at https://developer.clashofclans.com and add this machine's
# public IP to its allowlist; Supercell rejects the token from any other IP
# with HTTP 403 "accessDenied".
# ---------------------------------------------------------------------------
COC_API_TOKEN=
CLAN_TAG=#2J0YP2LQL

# Override the API host. Use the proxy when the caller's egress IP is not the
# one on the token's allowlist (that is why the 99N scrapers default to it):
#   COC_API_BASE_URL=https://cocproxy.royaleapi.dev/v1
COC_API_BASE_URL=

# How long a fetched answer is reused, in seconds. The bot refreshes in the
# background on interval-60, so no command ever waits on a socket.
COC_CACHE_SECONDS=600

# Cap the per-member profile lookup (one request each, ~50 for a full clan).
# Empty means every member; set it to trade accuracy for fewer requests.
COC_PLAYER_LIMIT=

# --- Logging -----------------------------------------------------------
# Empty LOG_CHANNEL_ID = console + logs/bot.log only (the default).
# Set it to a channel id to also mirror log lines into that Discord channel,
# which requires the Logging bot to have Send Messages + Embed Links there.
LOG_CHANNEL_ID=
# DEBUG | INFO | WARNING | ERROR | CRITICAL — invalid values fall back to INFO.
LOG_LEVEL=INFO
