# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Prefix for text commands (slash commands are always /)
BOT_PREFIX=!

# Dev guild id -> slash commands sync instantly. Leave empty for global sync.
DISCORD_GUILD_ID=

# Paths to the 99N scraper output and assets.
# Relative paths resolve against this bot's own directory, not the shell's cwd.
# Defaults point at the sibling ../99N checkout when unset.
DATA_DIR=../99N/data
ASSET_DIR=../99N/assets

# Where per-guild config and runtime state are stored.
CONFIG_DIR=./config/guilds

# Timezone used for quiet hours.
BOT_TIMEZONE=Asia/Jakarta
